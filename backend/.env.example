# Copy this file to .env and fill in real values. NEVER commit .env.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (create a dedicated DB user for this app)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/stock-portfolio?retryWrites=true&w=majority

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Allowed browser origins (comma separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# bcrypt cost factor (12 is a good default)
BCRYPT_ROUNDS=12

# Set to 1 when running behind a reverse proxy (Render, Heroku, nginx...)
TRUST_PROXY=0

# Optional rate-limit tuning
# RATE_LIMIT_MAX=300
# LOGIN_RATE_LIMIT_MAX=10
# REGISTER_RATE_LIMIT_MAX=20
